# ==============================================================================
# FFWS Broadcast Overlay Suite - Environment Configuration Template
# ==============================================================================

# 1. Google Sheets & Drive API Integration
# ------------------------------------------------------------------------------
# The ID of your tournament Google Spreadsheet (found in the sheet URL):
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account client email (e.g., xxx@xxx.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com

# Google Service Account private key (paste the full RSA private key with \n or newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Drive Folder ID containing team logo files (.png/.jpg)
# https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# 2. Admin Authentication & Security
# ------------------------------------------------------------------------------
# Master password required to unlock the Admin Panel (/admin) and Protected Root (/)
ADMIN_PASSWORD=your_secure_admin_password_here

# Strong random secret key used to sign the HttpOnly session token (HMAC-SHA256)
ADMIN_SECRET=generate_a_random_32_or_64_char_secret_key_here
